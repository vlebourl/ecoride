{
  "name": "ecoride",
  "version": "2.51.7",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:client": "bun run --filter client dev",
    "dev:server": "bun run --filter server dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:non-destructive": "bun --cwd server scripts/db-migrate-non-destructive.ts",
    "db:push:local": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:local": "bun run format:check && bun run lint && bun run typecheck",
    "quality:complexity": "fta .",
    "depcruise": "bun run depcruise:client && bun run depcruise:server && bun run depcruise:shared && bun run depcruise:orphans",
    "depcruise:client": "depcruise --config .dependency-cruiser.mjs client/src",
    "depcruise:server": "depcruise --config .dependency-cruiser.mjs server/src",
    "depcruise:shared": "depcruise --config .dependency-cruiser.mjs shared",
    "depcruise:orphans": "depcruise --config .dependency-cruiser.mjs client/src server/src shared",
    "depcruise:orphans:json": "depcruise --config .dependency-cruiser.mjs --output-type json client/src server/src shared",
    "knip": "knip --config knip.jsonc --reporter compact --workspace . --workspace client --workspace server --workspace shared --no-exit-code",
    "knip:strict": "knip --config knip.jsonc --reporter compact --workspace . --workspace client --workspace server --workspace shared",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/web-bluetooth": "^0.0.21",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.1",
    "fta-cli": "^3.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
